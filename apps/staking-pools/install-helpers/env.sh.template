#!/usr/bin/env bash
# Staking pool install helpers — copy to env.sh and edit.
# Both scripts source env.sh from this directory when present.
# Never commit env.sh (git-ignored).

# === Required ===
# Execution-layer JSON-RPC. Network (mainnet / bepolia) is read from eth_chainId.
EL_RPC_URL="${EL_RPC_URL:-https://bepolia.rpc.berachain.com}"

# Beacon Kit Node API base URL (install.sh only). Enable in validator app.toml.
CL_NODE_API_URL="${CL_NODE_API_URL:-http://127.0.0.1:3500}"

# === Optional signing ===
# When set, scripts offer to run cast send after you confirm.
# When unset, run each printed command on your Ledger machine and paste the tx hash.
# PRIVATE_KEY=

# === Optional prompt defaults (install.sh) ===
# Scripts still ask; press Enter to accept the bracketed value.
# VALIDATOR_PUBKEY=0x
# FUNDING_ADDRESS=0x          # cold signing; ignored when PRIVATE_KEY is set
# OPERATOR_ADDRESS=0x         # self-funded path only
# SHARES_RECIPIENT=0x          # self-funded path only

# === Optional prompt defaults (delegator-delegate.sh) ===
# VALIDATOR_PUBKEY=0x
# DELEGATE_AMOUNT_BERA=500000
# VALIDATOR_ADMIN=0x
