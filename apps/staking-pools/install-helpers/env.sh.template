#!/usr/bin/env bash
# Staking Pool Configuration

# Path to beacond home (e.g., ~/.beacond or /path/to/berabox/installation)
BEACOND_HOME="${BEACOND_HOME:-}"

# Optional: Path to beacond binary (defaults to "beacond" in PATH)
# BEACOND_BIN="${BEACOND_BIN:-beacond}"

# Optional: Node API address for activation (leave blank to auto-detect from app.toml)
NODE_API_ADDRESS="${NODE_API_ADDRESS:-127.0.0.1:3500}"

# Optional hot key on this validator host. Required only for pool-cli --execute.
# Default pool-cli path prints `cast send --ledger` for a signing machine.
# Do not attach a Ledger to the validator.
#    PRIVATE_KEY="0x..."
PRIVATE_KEY="${PRIVATE_KEY:-}"





